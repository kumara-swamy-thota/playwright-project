# ---------------------------------------------------------------------------
# Environment configuration. Copy this file to .env and fill in real values.
# Never commit the real .env file — it is already in .gitignore.
# ---------------------------------------------------------------------------

# Which environment config to load (development | staging | production)
ENV=development

# Base URLs per environment
DEV_BASE_URL=https://www.saucedemo.com
STAGING_BASE_URL=https://staging.example.com
PROD_BASE_URL=https://www.example.com

# Test user credentials (use a secrets manager / CI secrets in real pipelines)
TEST_USERNAME=standard_user
TEST_PASSWORD=secret_sauce
LOCKED_USER=locked_out_user
PROBLEM_USER=problem_user

# API base URL, if this project also exercises APIs
API_BASE_URL=https://api.example.com
API_KEY=

# Misc
CI=false
HEADLESS=true
TRACE_MODE=on-first-retry
